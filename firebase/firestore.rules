rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isAuthor() {
      return signedIn() && request.resource.data.authorUid == request.auth.uid;
    }

    function isExistingAuthor() {
      return signedIn() && resource.data.authorUid == request.auth.uid;
    }

    match /users/{uid} {
      allow read: if signedIn() && request.auth.uid == uid;
      allow create: if signedIn() && request.auth.uid == uid;
      allow update: if signedIn() && request.auth.uid == uid;
    }

    match /otpRequests/{email} {
      allow read, write: if false;
    }

    match /otpRateLimits/{key} {
      allow read, write: if false;
    }

    match /mail/{id} {
      allow read, write: if false;
    }

    match /pages/{pageId} {
      allow read: if signedIn();
      allow create, update: if signedIn();

      match /comments/{commentId} {
        allow read: if signedIn();

        allow create: if isAuthor()
          && request.resource.data.keys().hasAll([
            'body', 'author', 'authorUid', 'createdAt', 'resolved', 'pin', 'replyCount'
          ])
          && request.resource.data.resolved == false
          && request.resource.data.replyCount == 0
          && request.resource.data.body is string
          && request.resource.data.body.size() > 0
          && request.resource.data.body.size() <= 2000;

        // Author may edit body (+ editedAt). Any signed-in user may toggle only
        // `resolved`, or bump `replyCount` via reply transactions.
        allow update: if signedIn() && (
          (
            isExistingAuthor()
            && request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['body', 'editedAt'])
            && request.resource.data.body is string
            && request.resource.data.body.size() > 0
            && request.resource.data.body.size() <= 2000
          )
          || (
            request.resource.data.diff(resource.data).affectedKeys().hasOnly(['resolved'])
            && request.resource.data.resolved is bool
          )
          || request.resource.data.diff(resource.data).affectedKeys().hasOnly(['replyCount'])
        );

        allow delete: if isExistingAuthor();

        match /replies/{replyId} {
          allow read: if signedIn();

          allow create: if isAuthor()
            && get(/databases/$(database)/documents/pages/$(pageId)/comments/$(commentId))
              .data.replyCount < 10
            && request.resource.data.body is string
            && request.resource.data.body.size() > 0
            && request.resource.data.body.size() <= 1000;

          allow update: if isExistingAuthor()
            && request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['body', 'editedAt'])
            && request.resource.data.body is string
            && request.resource.data.body.size() > 0
            && request.resource.data.body.size() <= 1000;

          allow delete: if isExistingAuthor();
        }

        match /reactions/{reactionId} {
          allow read: if signedIn();
          allow create: if signedIn()
            && request.resource.data.uid == request.auth.uid
            && request.resource.data.emoji is string;
          allow delete: if signedIn()
            && resource.data.uid == request.auth.uid;
        }
      }
    }
  }
}
